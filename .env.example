NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. This key bypasses all security rules.
# It must NEVER be exposed to the browser: never prefix it with NEXT_PUBLIC_
# and never import it in a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
